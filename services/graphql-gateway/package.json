{
  "name": "@aegisvolt/graphql-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/interfaces/graphql/schema.graphql dist/interfaces/graphql/schema.graphql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "graphql:validate": "tsx scripts/validate-schema.ts"
  },
  "dependencies": {
    "@aegisvolt/shared": "1.0.0",
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0"
  }
}
