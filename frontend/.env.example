# URL GraphQL (vía API Gateway) de cada ambiente. scripts/frontend-env.sh las genera desde Terraform.
GRAPHQL_URL_DEV=http://localhost:4566/_aws/execute-api/<api-id-dev>/graphql
GRAPHQL_URL_TEST=http://localhost:4566/_aws/execute-api/<api-id-test>/graphql
GRAPHQL_URL_PROD=http://localhost:4566/_aws/execute-api/<api-id-prod>/graphql
DEFAULT_ENVIRONMENT=dev
